# Copy to .env.local for local development. On Vercel, set the same names in
# Project Settings -> Environment Variables (see docs/DEPLOY-VERCEL.md).

# Required - Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Optional - server only, never prefix with NEXT_PUBLIC_.
# Needed only for "Delete account" in Learner/Admin Settings.
SUPABASE_SERVICE_ROLE_KEY=

# Optional - hCaptcha site key; only has an effect once captcha protection is
# enabled in Supabase (Authentication -> Attack Protection).
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=

# Optional - set to "vercel" to skip the Cloudflare dev emulator in `npm run dev`.
DEPLOY_TARGET=

# --- AI (Asisten pelajaran, Bahas jawaban, dan fitur AI lain) ---
# Fitur AI tidak dirender sama sekali bila AI_ENABLED bukan "true" atau kunci
# penyedia aktifnya kosong. Bukan tampil lalu gagal -- tidak tampil.
AI_ENABLED=true

# Penyedia: "openai" (format chat/completions -- DeepSeek dan yang kompatibel)
# atau "gemini". Kosong berarti gemini, yaitu perilaku sebelum adapter kedua ada.
AI_PROVIDER=openai

# Dipakai adapter "openai".
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=

# Dipakai adapter "gemini".
GEMINI_API_KEY=

# Kosong = bawaan per penyedia (deepseek-flash / gemini-3.1-flash-lite).
# Diukur 10 Nov 2026: deepseek-flash 1,4-2,0 detik; gemini-3.1-flash-lite
# 4,4-7,2 detik. Hindari gemini-flash-latest: sering 503 dan berpikir panjang
# secara bawaan sampai melewati batas durasi fungsi Vercel.
AI_MODEL=
